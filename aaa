    <!-- TOAST NOTIFICATION POPUP -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col space-y-2 pointer-events-none"></div>

    <script>
        /* ========================================================================== */
        /* CLASSPULSE APPLICATION STATE & INITIAL DATA                                */
        /* ========================================================================== */

        const DEFAULT_STATUSES = [
            { id: 's1', name: 'Coming', icon: '🟢', color: '#10B981', bgColor: '#ECFDF5', textColor: '#065F46', order: 1 },
            { id: 's3', name: 'Not coming', icon: '🔴', color: '#EF4444', bgColor: '#FEE2E2', textColor: '#991B1B', order: 2 },
            { id: 's5', name: 'Pending', icon: '⚪', color: '#6B7280', bgColor: '#F3F4F6', textColor: '#374151', order: 3 },
            { id: 's8', name: 'Cancelled', icon: '⚫', color: '#374151', bgColor: '#E5E7EB', textColor: '#1F2937', order: 4 }
        ];

        // Format date string to YYYY-MM-DD
        function getYYYYMMDD(dateObj) {
            const year = dateObj.getFullYear();
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const day = String(dateObj.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        const todayStr = getYYYYMMDD(new Date());
        
        // Calculate tomorrow string
        const tomorrowObj = new Date();
        tomorrowObj.setDate(tomorrowObj.getDate() + 1);
        const tomorrowStr = getYYYYMMDD(tomorrowObj);

        const DEFAULT_TEACHERS = [
            { id: 't1', name: 'Abebe Kebede', subject: 'Mathematics', room: 'B204', statusId: 's1', effectiveDate: todayStr, updatedAt: new Date().toISOString() },
            { id: 't2', name: 'Hana Tesfaye', subject: 'Physics', room: 'C102', statusId: 's3', effectiveDate: todayStr, updatedAt: new Date(Date.now() - 300000).toISOString() },
            { id: 't3', name: 'Daniel Alemu', subject: 'English', room: 'A201', statusId: 's1', effectiveDate: todayStr, updatedAt: new Date(Date.now() - 120000).toISOString() },
            { id: 't4', name: 'Meron Yohannes', subject: 'Biology', room: 'C203', statusId: 's5', effectiveDate: todayStr, updatedAt: new Date(Date.now() - 600000).toISOString() },
            { id: 't5', name: 'Samuel Tadesse', subject: 'Chemistry', room: 'B105', statusId: 's5', effectiveDate: tomorrowStr, updatedAt: new Date(Date.now() - 1500000).toISOString() },
            { id: 't6', name: 'Saba Tilahun', subject: 'Computer Science', room: 'Lab 3', statusId: 's1', effectiveDate: todayStr, updatedAt: new Date().toISOString() },
            { id: 't7', name: 'Yonas Getachew', subject: 'History', room: 'A104', statusId: 's8', effectiveDate: todayStr, updatedAt: new Date(Date.now() - 900000).toISOString() }
        ];

        // Zero-based initial weekly structure
        const ZERO_WEEKLY_TRAFFIC = [
            { day: 'Mon', views: 0, isToday: false },
            { day: 'Tue', views: 0, isToday: false },
            { day: 'Wed', views: 0, isToday: false },
            { day: 'Thu', views: 0, isToday: false },
            { day: 'Fri', views: 0, isToday: true },
            { day: 'Sat', views: 0, isToday: false },
            { day: 'Sun', views: 0, isToday: false }
        ];

        // Global State Variables
        let state = {
            currentRoute: 'student',
            isAdminAuthenticated: false,
            teachers: [],
            statuses: [],
            selectedStatusFilter: 'ALL',
            searchQuery: '',
            dateFilterMode: 'auto',
            customFilterDate: todayStr,
            pollingInterval: null,
            lastUpdatedTimestamp: new Date(),
            analytics: {
                totalViews: 0,
                activeOnline: 1,
                weeklyViews: ZERO_WEEKLY_TRAFFIC
            }
        };

        function initStorage() {
            const savedStatuses = localStorage.getItem('classpulse_statuses');
            const savedTeachers = localStorage.getItem('classpulse_teachers');
            const savedAuth = localStorage.getItem('classpulse_admin_auth');
            const savedAnalytics = localStorage.getItem('classpulse_analytics');

            state.statuses = savedStatuses ? JSON.parse(savedStatuses) : DEFAULT_STATUSES;
            state.teachers = savedTeachers ? JSON.parse(savedTeachers) : DEFAULT_TEACHERS;
            state.isAdminAuthenticated = savedAuth === 'true';

            if (savedAnalytics) {
                state.analytics = JSON.parse(savedAnalytics);
                if (state.analytics.totalViews === undefined) {
                    state.analytics.totalViews = 0;
                }
            } else {
                state.analytics = {
                    totalViews: 0,
                    activeOnline: 1,
                    weeklyViews: ZERO_WEEKLY_TRAFFIC
                };
            }

            // Increment page view counters starting from 0
            incrementPageViewCounters();

            // Ensure all teachers have an effectiveDate
            state.teachers.forEach(t => {
                if (!t.effectiveDate) t.effectiveDate = todayStr;
            });

            saveStateToStorage();
        }

        function incrementPageViewCounters() {
            state.analytics.totalViews += 1;

            if (!state.analytics.weeklyViews) {
                state.analytics.weeklyViews = ZERO_WEEKLY_TRAFFIC;
            }

            const todayItem = state.analytics.weeklyViews.find(item => item.isToday);
            if (todayItem) {
                todayItem.views += 1;
            } else if (state.analytics.weeklyViews.length > 0) {
                state.analytics.weeklyViews[4].views += 1;
            }

            updateTotalViewsHeaderBadge();
        }

        function saveStateToStorage() {
            localStorage.setItem('classpulse_statuses', JSON.stringify(state.statuses));
            localStorage.setItem('classpulse_teachers', JSON.stringify(state.teachers));
            localStorage.setItem('classpulse_admin_auth', state.isAdminAuthenticated ? 'true' : 'false');
            localStorage.setItem('classpulse_analytics', JSON.stringify(state.analytics));
        }

        function resetAnalyticsToZero() {
            state.analytics = {
                totalViews: 0,
                activeOnline: 1,
                weeklyViews: JSON.parse(JSON.stringify(ZERO_WEEKLY_TRAFFIC))
            };
            saveStateToStorage();
            updateTotalViewsHeaderBadge();
            renderAnalyticsTab();
            showToast('All view counters reset to 0', 'info');
        }

        function updateTotalViewsHeaderBadge() {
            const el = document.getElementById('headerTotalViewsCount');
            if (el) el.textContent = state.analytics.totalViews.toLocaleString();
        }

        /* ========================================================================== */
        /* STARTUP LOADING ANIMATION (1% -> 100%) WITH SAFE NULL GUARDS              */
        /* ========================================================================== */

        function runStartupLoadingAnimation() {
            const loaderPercentText = document.getElementById('loaderPercentText');
            const loaderProgressBar = document.getElementById('loaderProgressBar');
            const appLoader = document.getElementById('appLoader');

            let currentProgress = 1;
            const interval = setInterval(() => {
                currentProgress += Math.floor(Math.random() * 8) + 4;
                if (currentProgress >= 100) {
                    currentProgress = 100;
                    clearInterval(interval);
                    
                    if (loaderPercentText) loaderPercentText.textContent = `100%`;
                    if (loaderProgressBar) loaderProgressBar.style.width = `100%`;

                    setTimeout(() => {
                        if (appLoader) {
                            appLoader.classList.add('opacity-0', 'pointer-events-none');
                            setTimeout(() => {
                                if (appLoader.parentNode) {
                                    appLoader.parentNode.removeChild(appLoader);
                                }
                            }, 500);
                        }
                    }, 200);
                } else {
                    if (loaderPercentText) loaderPercentText.textContent = `${currentProgress}%`;
                    if (loaderProgressBar) loaderProgressBar.style.width = `${currentProgress}%`;
                }
            }, 30);
        }

        // Initialize App on DOM Ready
        window.addEventListener('DOMContentLoaded', () => {
            initStorage();
            runStartupLoadingAnimation();
            renderIcons();
            renderAllViews();

            // Set up polling (30 seconds check)
            state.pollingInterval = setInterval(() => {
                refreshData(false);
            }, 30000);

            // Fluctuate active visitors count gently
            setInterval(simulateLiveVisitorFluctuation, 7000);
        });

        // Safe Lucide icon rendering wrapper
        function renderIcons() {
            if (typeof lucide !== 'undefined' && lucide.createIcons) {
                lucide.createIcons();
            }
        }

        /* ========================================================================== */
        /* LIVE VISITOR SIMULATOR & ANALYTICS RENDER                                  */
        /* ========================================================================== */

        function simulateLiveVisitorFluctuation() {
            const delta = Math.floor(Math.random() * 3) - 1;
            state.analytics.activeOnline = Math.max(1, Math.min(12, state.analytics.activeOnline + delta));

            const badge = document.getElementById('headerLiveVisitorCount');
            if (badge) badge.textContent = state.analytics.activeOnline;

            const adminActive = document.getElementById('analyticsActiveOnline');
            if (adminActive) adminActive.textContent = state.analytics.activeOnline;
        }

        function renderAnalyticsTab() {
            const totalViewsEl = document.getElementById('analyticsTotalViews');
            const todayViewsEl = document.getElementById('analyticsTodayViews');
            const weeklyViewsEl = document.getElementById('analyticsWeeklyViews');
            const activeOnlineEl = document.getElementById('analyticsActiveOnline');
            const avgDailyEl = document.getElementById('analyticsAvgDaily');
            const chartContainer = document.getElementById('weeklyChartBarsContainer');

            const weeklyData = state.analytics.weeklyViews || ZERO_WEEKLY_TRAFFIC;
            const todayItem = weeklyData.find(d => d.isToday) || { views: 0 };
            
            const totalWeekly = weeklyData.reduce((acc, curr) => acc + curr.views, 0);
            const maxViews = Math.max(...weeklyData.map(d => d.views), 1);
            const avgDaily = Math.round(totalWeekly / weeklyData.length);

            if (totalViewsEl) totalViewsEl.textContent = state.analytics.totalViews.toLocaleString();
            if (todayViewsEl) todayViewsEl.textContent = todayItem.views.toLocaleString();
            if (weeklyViewsEl) weeklyViewsEl.textContent = totalWeekly.toLocaleString();
            if (activeOnlineEl) activeOnlineEl.textContent = state.analytics.activeOnline;
            if (avgDailyEl) avgDailyEl.textContent = `${avgDaily} views/day`;

            // Render Weekly Bar Chart
            if (chartContainer) {
                chartContainer.innerHTML = weeklyData.map(item => {
                    const heightPercent = item.views === 0 ? 6 : Math.max(15, Math.round((item.views / maxViews) * 100));
                    const isToday = item.isToday;

                    return `
                        <div class="flex-1 flex flex-col items-center justify-end h-full group relative">
                            <!-- Tooltip -->
                            <div class="absolute -top-10 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none bg-slate-900 text-white text-[10px] font-semibold px-2 py-1 rounded shadow-md z-20 whitespace-nowrap">
                                ${item.day}: ${item.views} views
                            </div>

                            <!-- Value Label -->
                            <span class="text-[10px] font-bold mb-1.5 text-notion-muted dark:text-notion-darkMuted group-hover:text-slate-900 dark:group-hover:text-white transition-colors">
                                ${item.views}
                            </span>

                            <!-- Bar Column -->
                            <div class="w-full max-w-[36px] rounded-t-lg transition-all duration-300 ${
                                isToday 
                                    ? 'bg-sky-500 hover:bg-sky-400 dark:bg-sky-400 dark:hover:bg-sky-300 shadow-sm' 
                                    : 'bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700'
                            }" style="height: ${heightPercent}%;"></div>

                            <!-- Day Label -->
                            <span class="text-xs font-semibold mt-2 ${
                                isToday ? 'text-sky-600 dark:text-sky-400 font-bold' : 'text-notion-muted dark:text-notion-darkMuted'
                            }">
                                ${item.day}
                            </span>
                        </div>
                    `;
                }).join('');
            }
        }

        /* ========================================================================== */
        /* AUTOMATIC 5:00 PM DATE CALCULATOR                                          */
        /* ========================================================================== */

        function getActiveTargetDate() {
            const now = new Date();
            const currentHour = now.getHours();

            if (state.dateFilterMode === 'today') {
                return { dateStr: todayStr, isAfter5pmRollover: false, label: 'Today' };
            }
            if (state.dateFilterMode === 'tomorrow') {
                return { dateStr: tomorrowStr, isAfter5pmRollover: false, label: 'Tomorrow' };
            }
            if (state.dateFilterMode === 'custom') {
                return { dateStr: state.customFilterDate, isAfter5pmRollover: false, label: 'Selected Date' };
            }

            // 'auto' mode logic: after 5:00 PM (17:00), shift date to Tomorrow
            if (currentHour >= 17) {
                return {
                    dateStr: tomorrowStr,
                    isAfter5pmRollover: true,
                    label: 'Tomorrow'
                };
            } else {
                return {
                    dateStr: todayStr,
                    isAfter5pmRollover: false,
                    label: 'Today'
                };
            }
        }

        function formatDisplayDate(dateYMD) {
            const parts = dateYMD.split('-');
            const dateObj = new Date(parts[0], parts[1] - 1, parts[2]);
            return dateObj.toLocaleDateString('en-US', {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
                year: 'numeric'
            });
        }

        /* ========================================================================== */
        /* ROUTING & VIEW SWITCHING                                                   */
        /* ========================================================================== */

        function switchRoute(route) {
            state.currentRoute = route;
            const studentView = document.getElementById('studentView');
            const adminView = document.getElementById('adminView');
            const navStudentBtn = document.getElementById('navStudentBtn');
            const navAdminBtn = document.getElementById('navAdminBtn');

            if (route === 'student') {
                if (studentView) studentView.classList.remove('hidden');
                if (adminView) adminView.classList.add('hidden');

                if (navStudentBtn) navStudentBtn.className = "px-3 py-1 text-xs font-medium rounded-md transition-notion text-slate-900 dark:text-white bg-white dark:bg-notion-darkCard shadow-xs";
                if (navAdminBtn) navAdminBtn.className = "px-3 py-1 text-xs font-medium rounded-md transition-notion text-notion-muted dark:text-notion-darkMuted hover:text-slate-900 dark:hover:text-white";
                
                renderStudentView();
            } else {
                if (studentView) studentView.classList.add('hidden');
                if (adminView) adminView.classList.remove('hidden');

                if (navAdminBtn) navAdminBtn.className = "px-3 py-1 text-xs font-medium rounded-md transition-notion text-slate-900 dark:text-white bg-white dark:bg-notion-darkCard shadow-xs";
                if (navStudentBtn) navStudentBtn.className = "px-3 py-1 text-xs font-medium rounded-md transition-notion text-notion-muted dark:text-notion-darkMuted hover:text-slate-900 dark:hover:text-white";

                renderAdminView();
            }
            renderIcons();
        }

        /* ========================================================================== */
        /* PUBLIC STUDENT DASHBOARD RENDERING                                         */
        /* ========================================================================== */

        function renderStudentView() {
            const activeDateInfo = getActiveTargetDate();
            
