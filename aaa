        function saveStatusForm(e) {
            e.preventDefault();
            const id = document.getElementById('modalStatusId').value;
            const name = document.getElementById('modalStatusName').value.trim();
            const icon = document.getElementById('modalStatusIcon').value.trim();
            const color = document.getElementById('modalStatusColor').value;

            const bgColor = hexToLightBg(color);
            const textColor = hexToDarkText(color);

            if (id) {
                const status = state.statuses.find(s => s.id === id);
                if (status) {
                    status.name = name;
                    status.icon = icon;
                    status.color = color;
                    status.bgColor = bgColor;
                    status.textColor = textColor;
                }
                showToast('Status updated', 'success');
            } else {
                const newStatus = {
                    id: 's_' + Date.now(),
                    name,
                    icon,
                    color,
                    bgColor,
                    textColor,
                    order: state.statuses.length + 1
                };
                state.statuses.push(newStatus);
                showToast('New status added', 'success');
            }

            saveStateToStorage();
            closeStatusModal();
            renderAllViews();
        }

        function deleteStatus(id) {
            if (state.statuses.length <= 1) {
                showToast('You must keep at least one status', 'error');
                return;
            }

            state.statuses = state.statuses.filter(s => s.id !== id);
            state.teachers.forEach(t => {
                if (t.statusId === id) {
                    t.statusId = state.statuses[0].id;
                }
            });

            saveStateToStorage();
            showToast('Status removed', 'info');
            renderAllViews();
        }

