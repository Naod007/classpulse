        function renderStatusFilterPills() {
            const container = document.getElementById('statusFilterPills');
            if (!container) return;

            const activeTargetDate = getActiveTargetDate().dateStr;
            const relevantTeachers = state.teachers.filter(t => t.effectiveDate === activeTargetDate);
            
            // Only keep Pending, Coming, Not coming, and Cancelled
            const allowedNames = ['coming', 'not coming', 'pending', 'cancelled'];
            const filteredStatuses = state.statuses.filter(s => allowedNames.includes(s.name.toLowerCase()));

            // All pill
            let html = `
                <button 
                    onclick="setFilter('ALL')" 
                    class="px-3 py-1.5 rounded-xl text-xs font-medium transition-all flex items-center space-x-1 whitespace-nowrap ${
                        state.selectedStatusFilter === 'ALL'
                            ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-xs'
                            : 'bg-white dark:bg-notion-darkCard text-notion-muted hover:text-slate-900 dark:hover:text-white border border-notion-border dark:border-notion-darkBorder'
                    }">
                    <span>All</span>
                    <span class="ml-1 text-[10px] opacity-75">(${relevantTeachers.length})</span>
                </button>
            `;

            // Individual Allowed Status Pills
            filteredStatuses.forEach(status => {
                const count = relevantTeachers.filter(t => t.statusId === status.id).length;
                const isSelected = state.selectedStatusFilter === status.id;

                html += `
                    <button 
                        onclick="setFilter('${status.id}')" 
                        class="px-3 py-1.5 rounded-xl text-xs font-medium transition-all flex items-center space-x-1.5 whitespace-nowrap ${
