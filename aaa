        function saveTeacherForm(e) {
            e.preventDefault();
            const id = document.getElementById('modalTeacherId').value;
            const name = document.getElementById('modalTeacherName').value.trim();
            const subject = document.getElementById('modalTeacherSubject').value.trim();
            const room = document.getElementById('modalTeacherRoom').value.trim();
            const effectiveDate = document.getElementById('modalTeacherDate').value || todayStr;
            const statusId = document.getElementById('modalTeacherStatus').value;

            if (id) {
                const teacher = state.teachers.find(t => t.id === id);
                if (teacher) {
                    teacher.name = name;
                    teacher.subject = subject;
                    teacher.room = room;
                    teacher.effectiveDate = effectiveDate;
                    teacher.statusId = statusId;
                    teacher.updatedAt = new Date().toISOString();
                }
                showToast('Teacher updated', 'success');
            } else {
                const newTeacher = {
                    id: 't_' + Date.now(),
                    name,
                    subject,
                    room,
                    effectiveDate,
                    statusId,
                    updatedAt: new Date().toISOString()
                };
                state.teachers.unshift(newTeacher);
                showToast('New teacher added', 'success');
            }

            saveStateToStorage();
            closeTeacherModal();
            renderAllViews();
        }

        function deleteTeacher(id) {
            const teacher = state.teachers.find(t => t.id === id);
            if (!teacher) return;

            state.teachers = state.teachers.filter(t => t.id !== id);
            saveStateToStorage();
            showToast(`Deleted ${teacher.name}`, 'info');
            renderAllViews();
