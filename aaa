<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClassPulse - Teacher Class Status</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        notion: {
                            bg: '#FBFBFA',
                            darkBg: '#191919',
                            card: '#FFFFFF',
                            darkCard: '#202020',
                            border: '#E9E9E7',
                            darkBorder: '#2F2F2F',
                            text: '#37352F',
                            darkText: '#D4D4D4',
                            muted: '#787774',
                            darkMuted: '#9B9B9B',
                            hover: '#F1F1EF',
                            darkHover: '#2A2A2A',
                            accent: '#2EAADC'
                        }
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Subtle smooth transitions */
        .transition-notion {
            transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Card appearing & entrance keyframes */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .animate-appear {
            animation: fadeInUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Pulse badge effect */
        @keyframes subtlePulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(0.96); }
        }

        .pulse-live {
            animation: subtlePulse 2.5s infinite ease-in-out;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #E1E1DE;
            border-radius: 9999px;
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #333333;
        }
    </style>
</head>
<body class="bg-notion-bg dark:bg-notion-darkBg text-notion-text dark:text-notion-darkText min-h-screen flex flex-col transition-colors duration-200">

    <!-- INITIAL APP LOADING OVERLAY -->
    <div id="appLoader" class="fixed inset-0 z-50 bg-white dark:bg-notion-darkBg flex flex-col items-center justify-center transition-opacity duration-300">
        <div class="max-w-xs w-full px-6 text-center space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 flex items-center justify-center mx-auto text-xl font-bold shadow-lg">
                ⚡
            </div>
            <div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white tracking-tight">ClassPulse</h2>
                <p class="text-xs text-notion-muted dark:text-notion-darkMuted mt-0.5">Initializing schedule & view analytics...</p>
            </div>
            
            <!-- Progress Percentage and Bar -->
            <div class="space-y-1.5 pt-2">
                <div class="flex justify-between items-center text-xs font-semibold text-slate-700 dark:text-slate-300">
                    <span>Loading</span>
                    <span id="loaderPercentText">1%</span>
                </div>
                <div class="w-full h-2 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden">
                    <div id="loaderProgressBar" class="h-full bg-slate-900 dark:bg-white rounded-full transition-all duration-75 w-[1%]"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- TOP NAVIGATION / BRAND BAR -->
    <header class="sticky top-0 z-30 bg-notion-bg/90 dark:bg-notion-darkBg/90 backdrop-blur-md border-b border-notion-border dark:border-notion-darkBorder transition-colors">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
            <!-- Brand & Route Indicator -->
            <div class="flex items-center space-x-3">
                <a href="#" onclick="switchRoute('student')" class="group flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-lg bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 flex items-center justify-center font-bold text-base shadow-sm group-hover:scale-105 transition-transform">
                        ⚡
                    </div>
                    <div>
                        <span class="font-semibold text-base tracking-tight group-hover:text-black dark:group-hover:text-white transition-colors">ClassPulse</span>
                        <span class="text-xs text-notion-muted dark:text-notion-darkMuted hidden sm:inline-block ml-2 border-l border-notion-border dark:border-notion-darkBorder pl-2">Live Teacher Status</span>
                    </div>
                </a>
            </div>

            <!-- Header Actions: Active Visitors + Total Views + Theme Toggle -->
            <div class="flex items-center space-x-2">
                <!-- Live Visitors Badge -->
                <div title="Active students right now" class="flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/50">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-live"></span>
                    <span id="headerLiveVisitorCount" class="font-bold">1</span>
                    <span class="hidden sm:inline">Online</span>
                </div>

                <!-- Total Views Badge -->
                <div title="Total visits across all time" class="flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-sky-50 text-sky-700 dark:bg-sky-950/40 dark:text-sky-400 border border-sky-200/60 dark:border-sky-800/50">
                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                    <span id="headerTotalViewsCount" class="font-bold">0</span>
                    <span class="hidden sm:inline">Views</span>
                </div>

                <!-- Admin / Student Switcher Toggle -->
                <div class="bg-notion-hover dark:bg-notion-darkHover p-0.5 rounded-lg border border-notion-border dark:border-notion-darkBorder flex items-center">
                    <button id="navStudentBtn" onclick="switchRoute('student')" class="px-3 py-1 text-xs font-medium rounded-md transition-notion text-slate-900 dark:text-white bg-white dark:bg-notion-darkCard shadow-xs">
                        Student View
                    </button>
                    <button id="navAdminBtn" onclick="switchRoute('admin')" class="px-3 py-1 text-xs font-medium rounded-md transition-notion text-notion-muted dark:text-notion-darkMuted hover:text-slate-900 dark:hover:text-white">
                        Admin Portal
                    </button>
                </div>

                <!-- Theme Toggle -->
                <button onclick="toggleDarkMode()" class="p-2 rounded-lg hover:bg-notion-hover dark:hover:bg-notion-darkHover text-notion-muted dark:text-notion-darkMuted hover:text-slate-900 dark:hover:text-white transition-colors" title="Toggle Light/Dark Theme">
                    <i data-lucide="moon" class="w-4 h-4 dark:hidden"></i>
                    <i data-lucide="sun" class="w-4 h-4 hidden dark:block"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT WRAPPER -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 md:py-8">

        <!-- ========================================== -->
        <!-- PUBLIC STUDENT DASHBOARD VIEW (`/`)        -->
        <!-- ========================================== -->
        <section id="studentView" class="space-y-6 animate-appear">
            <!-- Header Banner with Automatic Date Calculation -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-2 border-b border-notion-border dark:border-notion-darkBorder">
                <div>
                    <div class="inline-flex items-center space-x-2 text-xs font-medium text-notion-muted dark:text-notion-darkMuted mb-1">
                        <span>Campus Live Dashboard</span>
                        <span>•</span>
                        <span id="lastUpdatedTime">Updated just now</span>
                    </div>
                    <!-- Heading with dynamic date after 5:00 PM -->
                    <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white flex flex-wrap items-center gap-2">
                        <span>Who's coming to class for</span>
                        <span id="headingDateBadge" class="text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/50 px-2.5 py-0.5 rounded-xl border border-sky-200 dark:border-sky-800/60 font-extrabold text-xl sm:text-2xl">
                            Loading date...
                        </span>
                        <span>?</span>
                    </h1>
                    <p id="scheduleRolloverNotice" class="text-xs text-notion-muted dark:text-notion-darkMuted mt-1">
                        Real-time status updates from teachers and faculty departments.
                    </p>
                </div>

                <!-- Action Controls: Manual Refresh -->
                <div class="flex items-center space-x-2">
                    <button onclick="refreshData(true)" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-notion-darkCard border border-notion-border dark:border-notion-darkBorder hover:bg-notion-hover dark:hover:bg-notion-darkHover transition-notion shadow-xs">
                        <i data-lucide="refresh-cw" id="refreshIcon" class="w-3.5 h-3.5 text-notion-muted"></i>
                        <span>Refresh</span>
                    </button>
                </div>
            </div>

            <!-- DATE FILTER BAR -->
            <div class="bg-white dark:bg-notion-darkCard p-3 rounded-2xl border border-notion-border dark:border-notion-darkBorder flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 shadow-xs">
                <!-- Date Filter Selector Buttons -->
                <div class="flex items-center space-x-2 overflow-x-auto pb-1 sm:pb-0">
                    <span class="text-xs font-semibold text-notion-muted whitespace-nowrap flex items-center space-x-1">
                        <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                        <span>View Date:</span>
                    </span>
                    <button id="dateFilterAutoBtn" onclick="setDateFilterMode('auto')" class="px-3 py-1 rounded-lg text-xs font-medium transition-notion bg-slate-900 text-white dark:bg-white dark:text-slate-900">
                        Default (<span id="autoFilterLabel">Today</span>)
                    </button>
                    <button id="dateFilterTodayBtn" onclick="setDateFilterMode('today')" class="px-3 py-1 rounded-lg text-xs font-medium transition-notion bg-notion-hover dark:bg-notion-darkHover text-notion-muted hover:text-slate-900 dark:hover:text-white">
                        Today
                    </button>
                    <button id="dateFilterTomorrowBtn" onclick="setDateFilterMode('tomorrow')" class="px-3 py-1 rounded-lg text-xs font-medium transition-notion bg-notion-hover dark:bg-notion-darkHover text-notion-muted hover:text-slate-900 dark:hover:text-white">
                        Tomorrow
                    </button>
                </div>

                <!-- Custom Date Input -->
                <div class="flex items-center space-x-2">
                    <span class="text-xs text-notion-muted whitespace-nowrap">Pick Date:</span>
                    <input type="date" id="studentCustomDatePicker" onchange="handleCustomDateChange(this.value)" class="px-2.5 py-1 text-xs rounded-lg bg-notion-bg dark:bg-notion-darkBg border border-notion-border dark:border-notion-darkBorder text-slate-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-slate-400">
                </div>
            </div>

            <!-- SEARCH AND STATUS FILTERS BAR -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
                <!-- Search Box -->
                <div class="relative md:col-span-5">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-notion-muted dark:text-notion-darkMuted"></i>
                    <input 
                        type="text" 
                        id="studentSearchInput" 
                        oninput="handleSearchFilter()" 
                        placeholder="Search teacher name, subject, or room..." 
                        class="w-full pl-9 pr-4 py-2 text-sm rounded-xl bg-white dark:bg-notion-darkCard border border-notion-border dark:border-notion-darkBorder focus:outline-none focus:ring-2 focus:ring-slate-400 dark:focus:ring-slate-600 transition-all text-slate-900 dark:text-slate-100 placeholder:text-notion-muted"
                    >
                </div>

                <!-- Status Filter Pills -->
                <div id="statusFilterPills" class="md:col-span-7 flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 no-scrollbar">
                    <!-- Dynamic Pills rendered via JS -->
                </div>
            </div>

            <!-- TEACHER CARDS CONTAINER -->
            <div id="teacherCardsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Teacher Cards generated dynamically -->
            </div>

            <!-- Empty Search State -->
            <div id="emptySearchState" class="hidden py-16 text-center bg-white dark:bg-notion-darkCard rounded-2xl border border-notion-border dark:border-notion-darkBorder p-8">
                <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3 text-notion-muted">
                    <i data-lucide="search-x" class="w-6 h-6"></i>
                </div>
                <h3 class="text-base font-semibold text-slate-900 dark:text-white">No teachers found</h3>
                <p class="text-xs text-notion-muted dark:text-notion-darkMuted mt-1 max-w-sm mx-auto">
                    We couldn't find any teacher matching your criteria for the selected date.
                </p>
                <button onclick="resetSearchAndFilters()" class="mt-4 px-4 py-1.5 rounded-lg text-xs font-medium bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 hover:opacity-90 transition-opacity">
                    Reset Filters
                </button>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- PROTECTED ADMIN DASHBOARD VIEW (`/admin`)  -->
        <!-- ========================================== -->
        <section id="adminView" class="hidden space-y-6 animate-appear">

            <!-- ADMIN AUTH LOGIN FORM (Shown when unauthenticated) -->
            <div id="adminLoginForm" class="max-w-md mx-auto my-12 bg-white dark:bg-notion-darkCard border border-notion-border dark:border-notion-darkBorder rounded-2xl p-6 md:p-8 shadow-notion">
                <div class="text-center mb-6">
                    <div class="w-12 h-12 rounded-2xl bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 flex items-center justify-center mx-auto mb-3 font-bold text-xl shadow-xs">
                        🔐
                    </div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Admin Access</h2>
                    <p class="text-xs text-notion-muted dark:text-notion-darkMuted mt-1">
                        Log in with administrator credentials to manage teacher statuses & track traffic.
                    </p>
                </div>

                <form onsubmit="handleAdminLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-notion-muted dark:text-notion-darkMuted mb-1">Username</label>
                        <input type="text" id="adminUser" required value="" class="w-full px-3.5 py-2 text-sm rounded-xl bg-notion-bg dark:bg-notion-darkBg border border-notion-border dark:border-notion-darkBorder focus:outline-none focus:ring-2 focus:ring-slate-400 text-slate-900 dark:text-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-notion-muted dark:text-notion-darkMuted mb-1">Password</label>
                        <input type="password" id="adminPass" required value="" class="w-full px-3.5 py-2 text-sm rounded-xl bg-notion-bg dark:bg-notion-darkBg border border-notion-border dark:border-notion-darkBorder focus:outline-none focus:ring-2 focus:ring-slate-400 text-slate-900 dark:text-white">
                    </div>

                    <div id="loginErrorMsg" class="hidden text-xs text-red-600 bg-red-50 dark:bg-red-950/40 dark:text-red-400 p-2.5 rounded-lg border border-red-200 dark:border-red-900">
                        Invalid credentials.
                    </div>

                    <button type="submit" class="w-full py-2.5 rounded-xl font-medium text-xs bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-opacity shadow-xs">
                        Sign In to Admin Portal
                    </button>
                </form>

                <div class="mt-4 pt-4 border-t border-notion-border dark:border-notion-darkBorder text-center">
                    <p class="text-[11px] text-notion-muted dark:text-notion-darkMuted">
                        Default Credentials: <code class="bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded"></code> / <code class="bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded"></code>
                    </p>
                </div>
            </div>

            <!-- AUTHENTICATED ADMIN PANEL CONTENT -->
            <div id="adminDashboardContent" class="hidden space-y-6">
                <!-- Admin Top Bar -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-notion-border dark:border-notion-darkBorder">
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300">Admin Mode</span>
                            <span class="text-xs text-notion-muted">Authenticated Session</span>
                        </div>
                        <h1 class="text-2xl font-bold text-slate-900 dark:text-white mt-1">ClassPulse Management</h1>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button onclick="openAddTeacherModal()" class="flex items-center space-x-1.5 px-3 py-2 rounded-xl text-xs font-semibold bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-notion shadow-xs">
                            <i data-lucide="user-plus" class="w-3.5 h-3.5"></i>
                            <span>Add Teacher</span>
                        </button>
                        <button onclick="handleAdminLogout()" class="flex items-center space-x-1.5 px-3 py-2 rounded-xl text-xs font-medium bg-white dark:bg-notion-darkCard border border-notion-border dark:border-notion-darkBorder hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/30 transition-notion text-notion-muted">
                            <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                            <span>Logout</span>
                        </button>
                    </div>
                </div>

                <!-- ADMIN NAVIGATION SUB-TABS -->
                <div class="flex items-center space-x-2 border-b border-notion-border dark:border-notion-darkBorder pb-2 overflow-x-auto">
                    <button onclick="setAdminTab('teachers')" id="tabBtnTeachers" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-notion bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white">
                        👨‍🏫 Teachers & Status Dates
                    </button>
                    <button onclick="setAdminTab('analytics')" id="tabBtnAnalytics" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-notion text-notion-muted hover:text-slate-900 dark:hover:text-white">
                        📊 Visitor Traffic Analytics
                    </button>
                    <button onclick="setAdminTab('statuses')" id="tabBtnStatuses" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition-notion text-notion-muted hover:text-slate-900 dark:hover:text-white">
                        🏷️ Custom Statuses
                    </button>
                </div>

                <!-- OVERVIEW STATISTICS COUNTERS -->
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3" id="adminStatsGrid">
                    <!-- Rendered dynamically -->
                </div>

                <!-- TAB 1: TEACHER MANAGEMENT TABLE -->
                <div id="adminTabTeachers" class="space-y-4">
                    <div class="bg-white dark:bg-notion-darkCard rounded-2xl border border-notion-border dark:border-notion-darkBorder overflow-hidden shadow-notion">
                        <div class="p-4 border-b border-notion-border dark:border-notion-darkBorder flex items-center justify-between">
                            <h2 class="text-sm font-semibold text-slate-900 dark:text-white">All Faculty Members & Class Dates</h2>
                            <span class="text-xs text-notion-muted" id="teacherCountBadge">0 Teachers</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead class="bg-notion-bg dark:bg-notion-darkBg text-notion-muted dark:text-notion-darkMuted font-medium uppercase tracking-wider border-b border-notion-border dark:border-notion-darkBorder">
                                    <tr>
                                        <th class="py-3 px-4">Teacher Name</th>
                                        <th class="py-3 px-4">Subject</th>
                                        <th class="py-3 px-4">Room</th>
                                        <th class="py-3 px-4">Effective Date</th>
                                        <th class="py-3 px-4">Current Status</th>
                                        <th class="py-3 px-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="adminTeacherTableBody" class="divide-y divide-notion-border dark:divide-notion-darkBorder text-slate-900 dark:text-slate-200">
                                    <!-- Dynamic Rows -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- TAB 2: VISITOR TRAFFIC ANALYTICS & WEEKLY GRAPH -->
                <div id="adminTabAnalytics" class="hidden space-y-6">
                    <!-- Live Traffic Summary Cards -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="bg-white dark:bg-notion-darkCard p-4 rounded-2xl border border-notion-border dark:border-notion-darkBorder shadow-xs">
                            <div class="flex items-center justify-between text-notion-muted dark:text-notion-darkMuted text-xs">
                                <span class="font-medium">Total All-Time Views</span>
                                <i data-lucide="eye" class="w-4 h-4 text-sky-500"></i>
                            </div>
                            <div class="mt-2 flex items-baseline space-x-2">
                                <span id="analyticsTotalViews" class="text-3xl font-extrabold text-slate-900 dark:text-white">0</span>
                                <span class="text-xs text-sky-600 dark:text-sky-400 font-semibold">Total</span>
                            </div>
                            <p class="text-[11px] text-notion-muted dark:text-notion-darkMuted mt-1">Total page views recorded across all visits</p>
                        </div>

                        <div class="bg-white dark:bg-notion-darkCard p-4 rounded-2xl border border-notion-border dark:border-notion-darkBorder shadow-xs">
                            <div class="flex items-center justify-between text-notion-muted dark:text-notion-darkMuted text-xs">
                                <span class="font-medium">Active Online Now</span>
                                <span class="w-2 h-2 rounded-full bg-emerald-500 pulse-live"></span>
                            </div>
                            <div class="mt-2 flex items-baseline space-x-2">
                                <span id="analyticsActiveOnline" class="text-3xl font-extrabold text-slate-900 dark:text-white">1</span>
                                <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">Live</span>
                            </div>
                            <p class="text-[11px] text-notion-muted dark:text-notion-darkMuted mt-1">Active users on ClassPulse</p>
                        </div>

                        <div class="bg-white dark:bg-notion-darkCard p-4 rounded-2xl border border-notion-border dark:border-notion-darkBorder shadow-xs">
                            <div class="flex items-center justify-between text-notion-muted dark:text-notion-darkMuted text-xs">
                                <span class="font-medium">Today's Page Views</span>
                                <i data-lucide="calendar" class="w-4 h-4"></i>
                            </div>
                            <div class="mt-2 flex items-baseline space-x-2">
                                <span id="analyticsTodayViews" class="text-3xl font-extrabold text-slate-900 dark:text-white">0</span>
                                <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold">Today</span>
                            </div>
                            <p class="text-[11px] text-notion-muted dark:text-notion-darkMuted mt-1">Page refreshes logged today</p>
                        </div>

                        <div class="bg-white dark:bg-notion-darkCard p-4 rounded-2xl border border-notion-border dark:border-notion-darkBorder shadow-xs">
