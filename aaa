            const activeTargetDate = getActiveTargetDate().dateStr;
            const query = state.searchQuery.toLowerCase().trim();
            const filtered = state.teachers.filter(t => {
                const matchesDate = (t.effectiveDate === activeTargetDate);
                const matchesSearch = 
                    t.name.toLowerCase().includes(query) ||
                    t.subject.toLowerCase().includes(query) ||
                    t.room.toLowerCase().includes(query);

                const matchesStatus = 
                    state.selectedStatusFilter === 'ALL' || 
                    t.statusId === state.selectedStatusFilter;

                return matchesDate && matchesSearch && matchesStatus;
            });

            if (filtered.length === 0) {
                grid.innerHTML = '';
